---
import Layout from '~/layouts/PageLayout.astro';

// Import du composant Image optimisé d’AstroWind
import Image from '~/components/common/Image.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import Sponsor from '~/components/widgets/Sponsor.astro';

import AnimatedImage from '~/components/ui/AnimatedImage.astro';

const metadata = {
  title: 'AFC JJB',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero>
    <Fragment slot="title">
      <div class="flex justify-center">
        <img
          src="/images/logo-final-web.png"
          alt="Logo AFC JJB"
          width="800"
          height="800"
          class="mx-auto h-auto w-[500px] md:w-[700px] intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
          style="animation-delay: 200ms"
        />
      </div>
    </Fragment>
  
    <Fragment slot="actions">
      <a
        href="#features"
        class="border border-black text-black py-2 px-6 rounded-lg bg-transparent hover:bg-black hover:text-white transition dark:border-white dark:text-white dark:hover:bg-white dark:hover:text-black"
      >
        Découvrir notre esprit
      </a>
    </Fragment>
  </Hero>

  
  

  <!-- Note Widget ******************* -->

  <Note /> 

  <!-- Features Widget *************** -->

  <Features
  id="features"
  tagline=""
  title="L'ESPRIT AFC JJB"
  subtitle="Fondé en 2025 à Quimper par Akhmed et Aslan ABDOULAEV, AFC JJB est né de la volonté de développer la pratique du Jiu-Jitsu Brésilien, du Grappling et du Pancrace. Affilié à la CFJJB et à la FFLDA, le club construit son identité autour de la transmission, de la maîtrise technique, de l’engagement et du respect, avec une même envie : apprendre, évoluer et partager la pratique."
  items={[
    {
  title: 'Un projet qui se développe',
  description:
    'Depuis sa création, AFC JJB poursuit son évolution à travers les entraînements, les stages, les rencontres avec d’autres clubs et la participation aux compétitions. Chaque saison contribue à enrichir l’expérience collective et à faire grandir le projet sportif du club.',
    },
    {
      title: 'Des Entraînements Adaptés à Tous',
      description:
        'Nos séances sont conçues pour progresser physiquement et mentalement, que vous soyez débutant ou confirmé. Chaque session est une opportunité d’évoluer sous l’accompagnement de nos entraîneurs expérimentés.',
    },
    {
      title: 'Une Communauté Ouverte et Solidaire',
      description:
        'AFC JJB, ce n’est pas juste un club, c’est une famille. Respect, discipline et entraide sont les piliers de notre communauté, forgeant un collectif où chacun progresse à son rythme. Chaque séance est un moment de partage pour une victoire collective.',
    },
    {
      title: 'Trois Disciplines Complémentaires',
      description:
        'Jiu-Jitsu Brésilien, Grappling et Pancrace : trois arts du combat, une seule passion. Développez vos compétences en technique, stratégie et contrôle, que ce soit debout ou au sol.',
    },
    {

}


  ]}
/>


<AnimatedImage
  src="/images/grappling1.jpg"
  alt="Aslan et Akhmed"
  delay={200}
  width={1600} // Augmenté pour une meilleure résolution
  height={1000} // Proportion adaptée
  class="max-w-[1400px] w-full h-auto mx-auto"
/>



  <!-- Content Widget **************** -->


  <Features
  id="cours"
  tagline=""
  title="NOS COURS"
  subtitle={`Envie de vous dépasser, de gagner en confiance et de vous sentir mieux dans votre corps comme dans votre esprit ?

  Que votre objectif soit d’améliorer votre condition physique, de découvrir les sports de combat, d’apprendre à vous défendre, de sortir de la routine ou de vous préparer à la compétition, AFC JJB vous accueille quel que soit votre niveau.

  Découvrez ci-dessous les disciplines proposées et trouvez celle qui vous correspond le mieux.`}

  />



  <!-- Content Widget **************** -->

  <Content
  id="jjb"  
  isAfterContent
  items={[
    {
      title: 'Origine et philosophie',
      description: `Issu du Judo et du Ju-Jitsu japonais, il a été perfectionné au Brésil avec un focus sur le combat au sol.`,
    },
    {
      title: 'Principes du combat',
      description: '<b>Debout</b> : Projections et renversements pour amener l’adversaire au sol.<br><b>Au sol</b> : Domination, contrôle et soumission grâce aux différentes techniques'
    },
    {
      title: 'Manières de gagner',
      description: '<b>Par soumission</b> : L’adversaire abandonne sous une clé ou un étranglement.<br><b>Par points</b> : Sans soumission, le combattant avec le plus de points gagne.'
    }
  ]}
  image={{ src: '~/assets/images/armbar.jpg', alt: 'jjb image' }}
>
  <Fragment slot="content">
    <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-left">Jiu-Jitsu Brésilien (JJB)</h3>
    <p class="text-lg text-left max-w-2xl">
      Le JJB, c’est l’art du contrôle et de la soumission. Pratiqué en kimono (Gi), il repose sur la technique et la stratégie plutôt que la force brute.
    </p>
  </Fragment>

  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
  </Fragment>
</Content>




  <!-- Content Widget **************** -->

  <Content
    id="grappling"
    isReversed
    isAfterContent
    items={[
      {
        title: 'Origine et philosophie',
        description:
          'Le Grappling partage ses racines avec la lutte libre et le Jiu-Jitsu Brésilien. Son objectif est de neutraliser un adversaire en utilisant la technique plutôt que la force, en exploitant les prises corporelles et le jeu au sol.',
      },
      {
        title: 'Principes du combat',
        description:
          'Le combat débute debout avec des techniques de lutte et de projections pour amener l’adversaire au sol. L’objectif au sol est de contrôler, progresser vers une position dominante et chercher une soumission.',
      },
      {
        title: 'Manières de gagner',
        description: '<b>Par soumission</b> : Abandon sur clé articulaire ou étranglement.<br><b>Par points</b> : Victoire par projections, passages de garde et contrôles.'
      }


    ]}
    image={{ src: '~/assets/images/akhmed-ali-vf.png', alt: 'Grappling Team'}}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Grappling</h3>
      Un art martial sans kimono (No-Gi), axé sur le contrôle, les projections et les soumissions. 
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
  id="pancrace"
  isAfterContent
  items={[
    {
      title: 'Origine et philosophie',
      description: `Héritier du pankration antique, le Pancrace a été modernisé avec des règles garantissant technique, sécurité et progression. Il allie la souplesse des arts martiaux et l’efficacité du combat libre.`,
    },
    {
      title: 'Principes du combat',
      description: `<b>Debout</b> : Striking (poings, pieds, genoux), esquives et projections.<br><b>Au sol</b> : Contrôle, positions dominantes et soumissions sans frappes au sol.`,
    },
    {
      title: 'Manières de gagner',
      description: `<b>Par soumission</b> : Abandon sur clé ou étranglement.<br><b>Par points</b> : Victoire selon l’efficacité technique.<br><b>Par arrêt de l’arbitre</b> : Pour garantir la sécurité des pratiquants.`,
    },
  ]}
  image={{ src: '~/assets/images/fight-1.png', alt: 'fight 1 image', width: 500, height: 550  }}
>
  <Fragment slot="content">
    <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Pancrace</h3>
    Un art martial complet alliant frappes, lutte et combat au sol, accessible à tous les niveaux. Une excellente porte d’entrée pour évoluer vers le MMA.
  </Fragment>

  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
  </Fragment>
</Content>



  <!-- Steps Widget ****************** -->

  <Steps
  title="Planning des cours"
  id="planning"
  items={[
      {
        title: '<span class="text-lg font-semibold text-gray-500">Lieu : Halle des Sports d’Ergué-Armel</span>',
        description: `
          <div class="text-base font-medium text-gray-500">
            <span class="font-semibold">Grappling :</span>
            <span class="font-normal">mardi de <strong>20h30</strong> à <strong>22h00</strong></span>
          </div>

          <div class="text-base font-medium text-gray-500">
            <span class="font-semibold">Grappling :</span>
            <span class="font-normal">jeudi de <strong>20h30</strong> à <strong>22h00</strong></span>
          </div>

          <div class="text-base font-medium text-gray-500 mt-3">
            <span class="font-semibold">Jiu-Jitsu Brésilien :</span>
            <span class="font-normal">lundi de <strong>21h00</strong> à <strong>22h30</strong></span>
          </div>

          <div class="text-base font-medium text-gray-500">
            <span class="font-semibold">Jiu-Jitsu Brésilien :</span>
            <span class="font-normal">vendredi de <strong>21h00</strong> à <strong>22h30</strong></span>
          </div>

          <div class="text-base font-medium text-gray-500 mt-3">
            <span class="font-semibold">Adresse :</span>
            <span class="font-normal">22 avenue Yves Thépot, Quimper</span>
          </div>
        `,
      },
      {
        title: '<span class="text-lg font-semibold text-gray-500">Lieu : MPT de Penhars</span>',
        description: `
          <div class="text-base font-medium text-gray-500">
            <span class="font-semibold">Pancrace :</span>
            <span class="font-normal">mercredi de <strong>20h00</strong> à <strong>21h30</strong></span>
          </div>

          <div class="text-base font-medium text-gray-500 mt-3">
            <span class="font-semibold">Adresse :</span>
            <span class="font-normal">39 boulevard de Bretagne, 29000 Quimper</span>
          </div>
        `,
      },
  ]}
  image={{ src: '~/assets/images/salle-dojo.png', alt: 'salle-dojo image' }}
/>


  <!-- Features2 Widget ************** -->

  <Features2
  title="ABDOULAEV FIGHTERS CLUB"
  subtitle="Nos Entraîneurs"
  id="equipe"
  tagline=""
  items={[
    {
      title: 'Akhmed ABDOULAEV',
      description: `
      <div style="text-align: justify;">
          <div style="text-align: center; margin-bottom: 8px;">
              <strong>FONDATEUR / PRÉSIDENT / ENTRAÎNEUR :</strong>
          </div>

          Akhmed Abdoulaev pratique les arts martiaux et les sports de combat depuis de nombreuses années, avec un parcours construit à travers plusieurs disciplines et de nombreuses expériences en compétition.<br><br>

          Il est <strong>ceinture noire de Jiu-Jitsu Brésilien</strong>, grade remis par <strong>Mestre Beto Ramos</strong>, professeur du club <strong>De La Riva Team Nantes</strong>.<br><br>

          Il est également <strong>ceinture noire de Judo</strong> et <strong>ceinture noire de Jiu-Jitsu Japonais</strong>. Pratiquant le Jiu-Jitsu Brésilien depuis 2011, Akhmed est aussi <strong>combattant professionnel de Mixed Martial Arts (MMA)</strong>. Son parcours comprend également la pratique du Grappling, du Sambo Combat, de la Boxe anglaise et du Kickboxing.<br><br>

          <strong>PALMARÈS SPORTIF :</strong>
          <ul>
              <li>🥇 <strong>Champion d’Europe IBJJF (Open) – 2012</strong>, Lisbonne.</li>
              <li>🥇 <strong>Champion d’Europe NAGA (Expert) Grappling – 2014</strong>, Paris.</li>
              <li>🥇 <strong>Ceinture NAGA – International JJB 2015</strong>, Monaco.</li>
              <li>🥇 <strong>Vainqueur Fight Select 3 (Pro) – 2015</strong>, Paris.</li>
              <li>🥇 <strong>Deux ceintures USC JJB – 2013 et 2015</strong>.</li>
              <li>🥇 <strong>Multi-médaillé régional en Judo</strong>.</li>
              <li>🥇 <strong>Multi-médaillé régional en Jiu-Jitsu Japonais</strong>.</li>
          </ul>
          <br>

          <strong>DIPLÔMES ET QUALIFICATIONS :</strong>
          <ul style="list-style: none; padding-left: 0;">
              <li>✓ <strong>BPJEPS – Éducateur sportif</strong>, mention LODA – Diplôme d’État.</li>
              <li>✓ <strong>Brevet Fédéral 2e degré – Entraîneur</strong>, option Grappling – FFLDA.</li>
              <li>✓ <strong>Brevet Fédéral 1er degré – Animateur</strong>, option Grappling – FFLDA.</li>
              <li>✓ <strong>Certificat d’Animateur Fédéral</strong> en Jiu-Jitsu Brésilien – CFJJB.</li>
              <li>✓ <strong>Arbitre National – Catégorie 1</strong>, Grappling – FFLDA.</li>
          </ul>
          <br>

          À AFC JJB, Akhmed conçoit et dirige les séances à partir d’une <strong>programmation annuelle structurée</strong>. Le cadre pédagogique reste commun, tandis que les exercices, les consignes et les variantes sont ajustés selon le niveau des pratiquants, du débutant au confirmé. L’enseignement accorde une place essentielle à la <strong>sécurité, à la maîtrise des fondamentaux, à la précision technique, à la compréhension tactique et à l’adaptation en situation</strong>.
          <br><br>

          <div style="text-align: center; font-style: italic; font-weight: bold; color: #ccc;">
              "Rien n'est impossible tant que je suis déterminé."
          </div>
      </div>
    `,
      image: { 
        src: '/images/akhmed-profile.jpg', 
        alt: 'Photo Akhmed ABDOULAEV',
        class: 'intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade', 
        style: 'animation-delay: 200ms;'
      }
    },

    {
      title: 'Aslan ABDOULAEV',
      description: `
      <div style="text-align: justify;">

          <div style="text-align: center; margin-bottom: 8px;">
              <strong>COFONDATEUR / ENCADRANT :</strong>
          </div>

          Aslan Abdoulaev pratique les arts martiaux et les sports de combat depuis de nombreuses années, avec un parcours construit à travers la pratique et la compétition.<br><br>

          Il est <strong>ceinture noire de Judo</strong> et <strong>ceinture noire de Jiu-Jitsu Japonais</strong>, ainsi que <strong>ceinture violette de Jiu-Jitsu Brésilien</strong>. Son expérience s’est développée au fil des années dans différentes disciplines et compétitions.<br><br>

          <strong>PALMARÈS SPORTIF :</strong>
          <ul>
              <li>🥇 <strong>Champion d’Europe IBJJF Open – 2013</strong>, Lisbonne.</li>
              <li>🥇 <strong>Ceinture NAGA – International JJB – 2015</strong>, Monaco.</li>
              <li>🥇 <strong>Multi-médaillé régional en Judo</strong>.</li>
              <li>🥇 <strong>Multi-médaillé régional en Jiu-Jitsu Japonais</strong>.</li>
          </ul>
          <br>

          Aslan contribue activement à <strong>l’encadrement des pratiquants</strong> et assure également certaines séances, en cohérence avec la <strong>programmation pédagogique établie pour la saison par Akhmed, entraîneur principal du club</strong>.<br><br>

          Son expérience acquise dans différents <strong>arts martiaux et sports de combat</strong> enrichit l’encadrement du club et lui permet d’accompagner les pratiquants dans leur évolution technique et leur pratique sur les tatamis.

          <br><br>

          <div style="text-align: center; font-style: italic; font-weight: bold; color: #ccc;">
              "Mon frère me pousse, et ma détermination brise toutes les limites."
          </div>

      </div>
    `,
      image: { 
        src: '/images/aslan-jjb.jpg', 
        alt: 'Photo Aslan ABDOULAEV',
        class: 'intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade', 
        style: 'animation-delay: 200ms;'
      }
    },
  ]}
/>




  <!-- FAQs Widget ******************* -->

  <FAQs
  title="Infos pratiques"
  subtitle=""
  tagline=""
  id="infos-pratiques"
  classes={{ container: 'max-w-6xl' }}
  items={[
    {
      title: 'PONCTUALITÉ ET ARRIVÉE',
      description:
        "Prévoyez d’arriver environ 10 minutes avant le début du cours afin de vous changer, vous préparer et, si besoin, échanger avec l’entraîneur avant la séance. Être prêt à l’heure permet également de commencer tous ensemble sans interrompre les explications ni le déroulement du cours. En cas de retard, merci de vous présenter à l’entraîneur avant de rejoindre le tatami.",
    },

    {
      title: 'DÉBUTER À AFC JJB',
      description:
        "Aucune expérience préalable ni condition physique particulière n’est nécessaire pour commencer. Les cours sont ouverts aux femmes comme aux hommes, avec des exercices et une intensité adaptés au niveau de chacun. Une séance d’essai permet de découvrir la discipline, le fonctionnement du club et l’ambiance des entraînements avant de s’engager. L’adhésion est ensuite nécessaire pour poursuivre la pratique.",
    },
        
    {
      title: 'TENUE ET ÉQUIPEMENT',
      description:
        "Jiu-Jitsu Brésilien (Gi) : kimono blanc ou noir obligatoire. AFC JJB propose un kimono personnalisé avec ceinture au tarif de 150 € l’ensemble. Grappling (No-Gi) : rashguard manches longues, short et legging obligatoires pour la pratique et l’hygiène. Un rashguard manches courtes avec short reste accepté temporairement. Une tenue No-Gi AFC JJB sera bientôt disponible. Pancrace : tenue similaire au Grappling, avec gants de boxe, mitaines, protège-tibias, protège-dents et coquille obligatoires. Chaque pratiquant doit avoir son propre équipement.",
    },
    
    {
      title: 'ÂGE & TARIFS',
      description:
        "Les inscriptions au Jiu-Jitsu Brésilien et au Grappling sont ouvertes à partir de 14 ans. Le tarif annuel est de 250 € pour une discipline. Une formule JJB + Grappling est proposée à 399 € par an. Pour cette formule, le règlement peut être effectué en deux fois, notamment par chèque. Des cours particuliers sont également proposés au tarif de 50 € de l’heure. Des créneaux destinés aux enfants pourront être développés à l’avenir.\n\nPour les personnes éligibles, le Pass’Sport, aide financière de l’État d’un montant de 70 €, peut être utilisé afin de réduire le coût de l’inscription.\n\nLe Pancrace est proposé à la MPT de Penhars au tarif de 100 € par an pour une séance hebdomadaire. L’inscription s’effectue directement auprès de la MPT. Le nombre de places étant limité, les inscriptions sont acceptées dans la limite des disponibilités.",
    },

    {
      title: 'HYGIÈNE ET VESTIAIRES',
      description:
        "Une tenue propre, lavée après chaque séance, est indispensable. Utilisez des claquettes en dehors des tatamis ; chaussures et chaussettes y sont interdites. Les ongles doivent être courts, les bijoux retirés et les cheveux longs attachés. En cas de plaie non protégée ou de problème de peau susceptible d’être contagieux, merci de ne pas participer à l’entraînement jusqu’à guérison. Des vestiaires avec douches sont à votre disposition. Pensez également à apporter une bouteille d’eau ou une gourde.",
    },

    {
      title: 'PROGRAMME VACANCES',
      description:
        "Pendant les vacances scolaires, les horaires et le planning des entraînements peuvent différer du programme habituel.\n\nDurant cette période, des stages payants peuvent également être proposés avec l’intervention d’un intervenant extérieur. Toutes les informations seront communiquées à l’avance sur le site internet du club.",
    },
    
    {
      title: 'SÉCURITÉ SUR LES TATAMIS',
      description:
        "Respectez les consignes de l’entraîneur et adaptez votre intensité au niveau et à l’expérience de votre partenaire. Lors des exercices et des combats, privilégiez le contrôle et relâchez immédiatement toute technique dès que votre partenaire abandonne. En cas de douleur ou de gêne, interrompez la pratique et informez l’entraîneur. En cas de retard, attendez son autorisation avant de rejoindre le tatami. Gardez votre bouteille d’eau à proximité afin de limiter les déplacements pendant la séance.",
    },

    {
      title: 'UNE QUESTION ?',
      description:
        "Vous avez une question sur le club, les entraînements ou les inscriptions ? Vous souhaitez devenir partenaire ou sponsor d’AFC JJB ? Contactez-nous, nous vous répondrons dans les meilleurs délais.",
    },
    

  ]}
/>

  <!-- CallToAction Widget *********** -->

  <CallToAction>
    <Fragment slot="title">
       Besoin d’une information ?
    </Fragment>
  
    <Fragment slot="actions">
      <a href="/contact"
        class="border border-black text-black py-2 px-6 rounded-lg bg-transparent hover:bg-black hover:text-white transition dark:border-white dark:text-white dark:hover:bg-white dark:hover:text-black"
      >
        Contactez-nous
      </a>
    </Fragment>
  </CallToAction>
  


  <!-- ✅ AJOUT DE CECI POUR AFFICHER LES SPONSORS -->
  <Sponsor
  sponsors={[
    { name: 'Vitasod', logo: 'images/vitasod.png', url: 'https://www.vitasod.fr/' },
    { name: 'Intersport', logo: 'images/intersport.png', url: 'https://www.intersport.fr/' },
    { name: 'Mairie de Quimper', logo: 'images/mairie-quimper.png', url: 'https://www.quimper.bzh/' },
    { name: 'MPT Penhars', logo: 'images/mpt-penhars.png', url: 'https://mptpenhars.goasso.org/' },
  ]}
/>


</Layout>
